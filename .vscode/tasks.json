{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🔑 registry: login",
      "type": "shell",
      "command": "docker login localhost:5000",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "🔐 registry: reset-password",
      "type": "shell",
      "command": "docker run --rm --entrypoint htpasswd httpd:2.4 -Bbn ${input:user} ${input:pass} > auth/registry.password",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "🚀 registry: up",
      "type": "shell",
      "command": "docker compose up -d",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "registry"
      },
      "problemMatcher": []
    },
    {
      "label": "🛑 registry: down",
      "type": "shell",
      "command": "docker compose down",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "registry"
      },
      "problemMatcher": []
    },
    {
      "label": "📜 registry: logs",
      "type": "shell",
      "command": "docker compose logs -f",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "registry"
      },
      "problemMatcher": []
    },
    {
      "label": "🔄 registry: restart",
      "type": "shell",
      "command": "docker compose restart",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "registry"
      },
      "problemMatcher": []
    },
    {
      "label": "🧹 registry: gc",
      "type": "shell",
      "command": "docker exec docker-registry bin/registry garbage-collect /etc/docker/registry/config.yml",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "user",
      "type": "promptString",
      "description": "Registry Username",
      "default": "admin"
    },
    {
      "id": "pass",
      "type": "promptString",
      "description": "New Registry Password"
    }
  ]
}
