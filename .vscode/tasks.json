{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 [Registry] Up",
      "detail": "Khởi chạy Docker Registry và Nginx UI dưới nền",
      "type": "shell",
      "command": "docker compose up -d",
      "presentation": { "reveal": "always", "panel": "shared", "group": "registry", "clear": true },
      "problemMatcher": [],
      "icon": { "id": "rocket", "color": "terminal.ansiYellow" }
    },
    {
      "label": "🛑 [Registry] Down",
      "detail": "Tắt toàn bộ dịch vụ Registry",
      "type": "shell",
      "command": "docker compose down",
      "presentation": { "reveal": "always", "panel": "shared", "group": "registry", "clear": true },
      "problemMatcher": [],
      "icon": { "id": "stop", "color": "terminal.ansiRed" }
    },
    {
      "label": "🔑 [Auth] Login",
      "detail": "Đăng nhập Docker client vào Registry cục bộ",
      "type": "shell",
      "command": "docker login localhost:5000",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": [],
      "icon": { "id": "key", "color": "terminal.ansiYellow" }
    },
    {
      "label": "🔐 [Auth] Reset Password",
      "detail": "Tạo lại mật khẩu bảo vệ Registry (ghi vào file htpasswd)",
      "type": "shell",
      "command": "docker run --rm --entrypoint htpasswd httpd:2.4 -Bbn ${input:user} ${input:pass} > auth/registry.password",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": [],
      "icon": { "id": "shield", "color": "terminal.ansiYellow" }
    },
    {
      "label": "🧹 [Maint] Garbage Collect",
      "detail": "Dọn dẹp rác hệ thống (xóa các Docker blobs mồ côi)",
      "type": "shell",
      "command": "docker exec docker-registry bin/registry garbage-collect /etc/docker/registry/config.yml",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": [],
      "icon": { "id": "trash", "color": "terminal.ansiRed" }
    },
    {
      "label": "📜 [Logs] Open Dozzle UI",
      "detail": "Xem log các container bằng giao diện Dozzle (Web UI)",
      "type": "shell",
      "command": "start http://localhost:8888",
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true },
      "problemMatcher": [],
      "icon": { "id": "browser", "color": "terminal.ansiMagenta" }
    },
    {
      "label": "🛡️ [SysAdmin] Setup Cockpit Firewall",
      "detail": "Cấu hình tường lửa cho máy chủ quản trị Cockpit",
      "type": "shell",
      "command": "chmod +x scripts/setup-cockpit.sh && ./scripts/setup-cockpit.sh",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": [],
      "icon": { "id": "play", "color": "terminal.ansiWhite" }
    }
  ],
  "inputs": [
    {
      "id": "user",
      "type": "promptString",
      "description": "Registry Username",
      "default": "admin"
    },
    {
      "id": "pass",
      "type": "promptString",
      "description": "New Registry Password"
    }
  ]
}