{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🔑 registry: login",
      "type": "shell",
      "command": "docker login localhost:5000",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "🔐 registry: reset-password",
      "type": "shell",
      "command": "docker run --rm --entrypoint htpasswd httpd:2.4 -Bbn ${input:user} ${input:pass} > auth/registry.password",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "🚀 registry: up (HTTP)",
      "type": "shell",
      "command": "docker compose up -d",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "registry"
      },
      "problemMatcher": []
    },
    {
      "label": "🔒 registry: up (HTTPS)",
      "type": "shell",
      "command": "docker compose -f docker-compose.ssl.yml up -d",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "registry"
      },
      "problemMatcher": []
    },
    {
      "label": "🛑 registry: down",
      "type": "shell",
      "command": "docker compose down",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "registry"
      },
      "problemMatcher": []
    },
    {
      "label": "📜 registry: logs",
      "type": "shell",
      "command": "docker compose logs -f",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "registry"
      },
      "problemMatcher": []
    },
    {
      "label": "🔄 registry: restart",
      "type": "shell",
      "command": "docker compose restart",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "registry"
      },
      "problemMatcher": []
    },
    {
      "label": "🧹 registry: gc",
      "type": "shell",
      "command": "docker exec docker-registry bin/registry garbage-collect /etc/docker/registry/config.yml",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "🔒 ssl: init",
      "type": "shell",
      "command": "chmod +x scripts/init-ssl.sh && REGISTRY_DOMAIN=${input:domain} CERTBOT_EMAIL=${input:email} ./scripts/init-ssl.sh",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "🛡️ firewall: setup",
      "type": "shell",
      "command": "chmod +x scripts/setup-ufw.sh && ./scripts/setup-ufw.sh ${input:fwMode}",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "🛡️ firewall: status",
      "type": "shell",
      "command": "sudo ufw status verbose",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "user",
      "type": "promptString",
      "description": "Registry Username",
      "default": "admin"
    },
    {
      "id": "pass",
      "type": "promptString",
      "description": "New Registry Password"
    },
    {
      "id": "domain",
      "type": "promptString",
      "description": "Registry Domain (e.g. hub.example.com)",
      "default": "hub.example.com"
    },
    {
      "id": "email",
      "type": "promptString",
      "description": "Certbot Email",
      "default": "you@email.com"
    },
    {
      "id": "fwMode",
      "type": "pickString",
      "description": "Firewall mode",
      "options": ["http", "https"],
      "default": "https"
    }
  ]
}
