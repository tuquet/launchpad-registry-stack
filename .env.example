# =============================================================================
# LaunchPad DevOps Ecosystem — Environment Variables
# Copy file này thành .env và điền giá trị thực tế
# =============================================================================

# ─── Registry Domain (dùng cho SSL mode) ──────────────────────────────────────
# Domain trỏ về IP VPS, ví dụ: hub.example.com
REGISTRY_DOMAIN=hub.example.com

# ─── Certbot Email (dùng cho SSL mode) ────────────────────────────────────────
# Email đăng ký Let's Encrypt certificate
CERTBOT_EMAIL=you@email.com
